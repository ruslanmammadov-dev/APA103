@using _27_FrontToBackSqlConnection.Areas.AdminPanel.ViewModels.Product
@using _27_FrontToBackSqlConnection.Models
@model List<ProductGetVM>

@{
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Product Table</h4>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <a asp-controller="Product" asp-action="Create" class="btn btn-outline-success btn-fw">
                                Create New Product
                            </a>
                            <tr>
                                <th>
                                    Count
                                </th>
                                <th>
                                    Image
                                </th>
                                <th>
                                    Name
                                </th>
                                <th>
                                    SKU
                                </th>
                                <th>
                                    Category
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (ProductGetVM item in Model)
                            {
                                <tr>
                                    <td>
                                        <p>@(++count)</p>
                                    </td>
                                    <td>
                                        <img src="~/assets/images/website-images/@item.Image" />
                                    </td>
                                    <td>
                                        @item.Name
                                    </td>
                                    <td>
                                        @item.Price
                                    </td>
                                    <td>
                                        @item.SKU
                                    </td>
                                    <td>
                                        @item.CategoryName
                                    </td>
                                    <td>
                                        <a asp-action="detail" asp-route-id="@item.Id" class="btn btn-outline-info btn-fw">Info</a>
                                        <a asp-action="delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-fw">Delete</a>
                                        <a asp-action="update" asp-route-id="@item.Id" class="btn btn-outline-warning btn-fw">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>