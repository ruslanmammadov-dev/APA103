@using _27_FrontToBackSqlConnection.Areas.AdminPanel.ViewModels.Product
@using _27_FrontToBackSqlConnection.Models
@model ProductCreateVM

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Create Product</h4>
                        </p>
                        <form class="forms-sample" method="post" asp-action="Create" enctype="multipart/form-data">
                            <div class="form-group">
                                <label asp-for="MainPhoto">MainPhoto</label>
                                <input asp-for="MainPhoto" class="form-control" placeholder="Enter Main Photo">
                                <span asp-validation-for="MainPhoto" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="HoverPhoto">Hover Photo</label>
                                <input asp-for="HoverPhoto" class="form-control" placeholder="Enter Hover Photo">
                                <span asp-validation-for="HoverPhoto" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="AdditionalPhoto">AdditionalPhoto</label>
                                <input asp-for="AdditionalPhoto" class="form-control" placeholder="Enter AdditionalPhoto">
                                <span asp-validation-for="AdditionalPhoto" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Name">Slider Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Enter slider Name">
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Price">Slider Price</label>
                                <input asp-for="Price" class="form-control" placeholder="Enter slider Price">
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="SKU">Slider SKU</label>
                                <input asp-for="SKU" class="form-control" placeholder="Enter slider SKU">
                                <span asp-validation-for="SKU" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Description">Product Description</label>
                                <textarea asp-for="Description" class="form-control" placeholder="Enter slider product"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="CategoryId">Category</label>
                                <select asp-for="CategoryId" class="form-control">
                                    <option selected disabled>-- Bir kateqoriya seçin --</option>
                                    @foreach (Category category in Model.Categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="TagIds">Tag</label>
                                <select asp-for="TagIds" class="form-control">
                                    @foreach (Tag category in Model.Tags)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="TagIds" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary me-2">Submit</button>
                            <a asp-action="Index" class="btn btn-light">Cancel</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>