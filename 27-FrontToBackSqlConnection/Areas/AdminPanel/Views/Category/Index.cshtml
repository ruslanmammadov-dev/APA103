@using _27_FrontToBackSqlConnection.Models
@model List<Category>

@{
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Category Table</h4>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <a asp-controller="Category" asp-action="Create" class="btn btn-outline-success btn-fw">
                                Create New Category
                            </a>
                            <tr>
                                <th>
                                    Count
                                </th>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Product
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (Category item in Model)
                            {
                                <tr>
                                    <td>
                                        <p>@(++count)</p>
                                    </td>
                                    <td>
                                        @item.Name
                                    </td>
                                    <td>
                                        @item.Products.Count
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-outline-info btn-fw">Info</button>
                                        <button type="button" class="btn btn-outline-danger btn-fw">Delete</button>
                                        <button type="button" class="btn btn-outline-warning btn-fw">Edit</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>