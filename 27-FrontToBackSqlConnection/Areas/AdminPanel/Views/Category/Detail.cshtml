@using _27_FrontToBackSqlConnection.Models
@model Category

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Category Table</h4>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <a asp-controller="Category" asp-action="Create" class="btn btn-outline-success btn-fw">
                                Create New Category
                            </a>
                            <tr>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Product
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                                <tr>
                                    <td>
                                        @Model.Name
                                    </td>
                                    <td>
                                        @Model.Products.Count
                                    </td>
                                </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>