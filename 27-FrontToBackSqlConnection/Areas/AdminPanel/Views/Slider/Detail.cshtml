@using _27_FrontToBackSqlConnection.Models
@model Slider

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Slider Table</h4>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <a asp-controller="Slider" asp-action="Create" class="btn btn-outline-success btn-fw">
                                Create New Slider
                            </a>
                            <tr>
                                <th>
                                    Image
                                </th>
                                <th>
                                    Title
                                </th>
                                <th>
                                    Subtitle
                                </th>
                                <th>
                                    Order
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                                <tr>
                                    <td>
                                        <img src="~/assets/images/website-images/@Model.Image" />
                                    </td>
                                    <td>
                                        @Model.Title
                                    </td>
                                    <td>
                                        @Model.Subtitle
                                    </td>
                                    <td>
                                        @Model.Order
                                    </td>
                                </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>